{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Provider and Assignment Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["selection", "providers", "models", "assignments"],
  "properties": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_default_model", "allow_user_override", "fallback_on", "review_independence"],
      "properties": {
        "company_default_model": {"type": "string", "minLength": 1},
        "allow_user_override": {"type": "boolean"},
        "fallback_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["rate-limit", "timeout", "provider-error", "capacity"]}
        },
        "review_independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["different_model_required", "different_provider_required"],
          "properties": {
            "different_model_required": {"type": "boolean"},
            "different_provider_required": {"type": "boolean"}
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "credential_ref", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "kind": {"enum": ["openai", "anthropic", "xai", "openrouter", "openai-compatible", "custom"]},
          "credential_ref": {"type": "string", "pattern": "^(secret|env)://[A-Z][A-Z0-9_]*$"},
          "endpoint_ref": {"type": "string", "pattern": "^(config|env)://[A-Z][A-Z0-9_]*$"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "model", "enabled", "execution_modes", "capabilities", "cost_tier", "latency_tier", "quality_tier"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "execution_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["interactive", "batch"]}
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          },
          "cost_tier": {"enum": ["economy", "standard", "premium", "unknown"]},
          "latency_tier": {"enum": ["fast", "standard", "slow", "unknown"]},
          "quality_tier": {"enum": ["standard", "high", "frontier", "unknown"]}
        }
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "scope_id", "primary_model", "fallback_models", "execution_mode", "user_selectable"],
        "properties": {
          "scope": {"enum": ["department", "agent", "task"]},
          "scope_id": {"type": "string", "minLength": 1},
          "primary_model": {"type": "string", "minLength": 1},
          "fallback_models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "execution_mode": {"enum": ["interactive", "batch"]},
          "user_selectable": {"type": "boolean"},
          "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}
        }
      }
    }
  }
}
